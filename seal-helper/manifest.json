{
  "manifest_version": 3,
  "name": "Seal Helper",
  "version": "1.5.1",
  "description": "A calmer, easier to read Seal. Changes how Seal looks in your browser only; it never writes to Seal and sends nothing anywhere.",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://us.platform.seal.run/o/malaghan/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Seal Helper",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
