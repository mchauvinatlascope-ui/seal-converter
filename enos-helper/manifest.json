{
  "manifest_version": 3,
  "name": "enos Helper",
  "version": "0.3.0",
  "description": "One-click shortcuts, a Ctrl K finder and your recent views for enos. Changes nothing in enos: it never writes there and sends nothing anywhere.",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://malaghan.poweredbyenos.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "enos Helper",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
